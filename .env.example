# Copy this file to .env and change the values. .env is not committed.
# The API server. Without it, the app uses https://shopboard-api.vercel.app/api.
# To test the loading, error and empty states, put /delay/3000, /fail/500 or /empty BEFORE /api:
# VITE_API_BASE_URL=https://shopboard-api.vercel.app/delay/3000/api
# VITE_API_BASE_URL=https://shopboard-api.vercel.app/fail/500/api
# VITE_API_BASE_URL=https://shopboard-api.vercel.app/empty/api
VITE_API_BASE_URL=https://shopboard-api.vercel.app/api
